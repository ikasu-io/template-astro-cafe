---
import type { CollectionEntry } from 'astro:content';
import Img from './Img.astro';
import { formatDate } from '../lib/site';

interface Props {
  post: CollectionEntry<'journal'>;
  sizes?: string;
  /** Photo shape, e.g. 'aspect-[4/5]'. */
  aspect?: string;
  /** Larger title, for the lead post. */
  large?: boolean;
}
const { post, sizes = '(min-width: 768px) 33vw, 100vw', aspect = 'aspect-[3/2]', large = false } = Astro.props;
const { title, date, author, summary, image } = post.data;
---

<article class="group relative">
  <div class:list={['overflow-hidden rounded-[2px] bg-sand', aspect]}>
    <Img name={image} sizes={sizes} class="size-full object-cover transition-transform duration-700 group-hover:scale-105" />
  </div>
  <p class="mt-5 text-xs font-semibold tracking-[0.14em] text-ink/70 uppercase">
    <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time> · {author}
  </p>
  <h3 class:list={['mt-2 leading-snug', large ? 'text-2xl sm:text-3xl' : 'text-2xl']}>
    <a href={`/journal/${post.id}`} class="after:absolute after:inset-0 group-hover:text-tide">{title}</a>
  </h3>
  <p class="mt-3 max-w-lg text-ink/75">{summary}</p>
</article>
