---
// One event as a line in a programme: the date large, the title, the
// details and a small photo. Used on the home page and the events page.
import type { CollectionEntry } from 'astro:content';
import Img from './Img.astro';
import { formatDate, formatTime } from '../lib/site';

interface Props { event: CollectionEntry<'events'>; past?: boolean }
const { event, past = false } = Astro.props;
const { title, date, time, endTime, price, image, summary } = event.data;
---

<article class:list={['event-row group relative grid grid-cols-[5.5rem_1fr] items-center gap-x-5 gap-y-3 border-b border-ink/15 py-7 sm:grid-cols-[6rem_1fr_10rem] sm:gap-x-10', past && 'past']}>
  <p class="leading-none">
    <span class="block font-display text-4xl sm:text-5xl">{formatDate(date, { day: 'numeric' })}</span>
    <span class="mt-2 block text-xs font-semibold tracking-[0.12em] whitespace-nowrap text-rust uppercase">{formatDate(date, { month: 'short' })} · {past ? formatDate(date, { year: 'numeric' }) : formatDate(date, { weekday: 'short' })}</span>
  </p>
  <div>
    <h3 class="text-2xl sm:text-3xl">
      <a href={`/events/${event.id}`} class="after:absolute after:inset-0">{title}</a>
    </h3>
    <p class="mt-2 max-w-xl text-ink/75">{summary}</p>
    <p class="mt-3 text-sm font-medium text-ink/70">{formatTime(time)}{endTime && `–${formatTime(endTime)}`} · {past ? 'Past event' : price}</p>
  </div>
  <div class="col-span-2 aspect-[4/3] overflow-hidden rounded-[2px] bg-sand sm:col-span-1">
    <Img name={image} sizes="(min-width: 640px) 10rem, 100vw" class:list={['size-full object-cover transition-transform duration-700 group-hover:scale-105', past && 'grayscale-[60%]']} />
  </div>
</article>
