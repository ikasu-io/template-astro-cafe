---
// A drawn map of the harbour. Ours, so no third-party map service, no
// cookies and no licence questions. Purely illustrative: Port Alder is
// fictional.
interface Props { class?: string }
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 640 420" role="img" aria-labelledby="map-title map-desc">
  <title id="map-title">Map of Port Alder harbour</title>
  <desc id="map-desc">Tern &amp; Tide is on Quay Row along the harbour wall. The 41 bus stops at Harbour Square to the west, the quay car park is to the east, and Chapel Street runs up from the square.</desc>
  <defs>
    <pattern id="waves" width="28" height="14" patternUnits="userSpaceOnUse">
      <path d="M0 7c3.5-4 10.5-4 14 0s10.5 4 14 0" fill="none" stroke="#2f5d62" stroke-opacity=".18" stroke-width="1.2" />
    </pattern>
  </defs>
  <rect width="640" height="420" fill="#efe6d8" />
  <!-- sea and harbour basin -->
  <path d="M0 300c90-14 170 6 250 2s160-26 250-18 100 10 140 4v132H0Z" fill="#cfdcd8" />
  <path d="M0 300c90-14 170 6 250 2s160-26 250-18 100 10 140 4v132H0Z" fill="url(#waves)" />
  <path d="M150 300v58h22v-50M470 290v74h-22v-66" fill="#d9c7a7" />
  <!-- streets -->
  <g fill="none" stroke="#faf6ef" stroke-linecap="round">
    <path d="M0 270h640" stroke-width="18" />
    <path d="M200 0v270" stroke-width="13" />
    <path d="M470 270 640 70" stroke-width="13" />
    <path d="M0 120h200" stroke-width="10" />
  </g>
  <!-- buildings -->
  <g fill="#d9c7a7">
    <rect x="20" y="140" width="70" height="40" rx="3" /><rect x="100" y="140" width="80" height="40" rx="3" />
    <rect x="20" y="20" width="160" height="80" rx="3" /><rect x="220" y="20" width="110" height="90" rx="3" />
    <rect x="340" y="20" width="120" height="90" rx="3" /><rect x="220" y="130" width="90" height="70" rx="3" />
    <rect x="220" y="215" width="70" height="40" rx="3" /><rect x="352" y="215" width="70" height="40" rx="3" />
    <rect x="432" y="190" width="40" height="65" rx="3" /><rect x="330" y="130" width="130" height="70" rx="3" />
    <path d="M500 255h140v-130l-60 70h-60Z" />
  </g>
  <!-- Harbour Square -->
  <rect x="20" y="198" width="160" height="58" rx="4" fill="#e3d6bf" />
  <!-- café -->
  <rect x="298" y="215" width="46" height="40" rx="3" fill="#b5532c" />
  <!-- car park -->
  <rect x="510" y="282" width="56" height="36" rx="4" fill="#2f5d62" />
  <text x="538" y="307" text-anchor="middle" font-family="Inter, sans-serif" font-weight="700" font-size="20" fill="#faf6ef">P</text>
  <!-- bus stop -->
  <circle cx="100" cy="228" r="13" fill="#2f5d62" />
  <text x="100" y="233" text-anchor="middle" font-family="Inter, sans-serif" font-weight="700" font-size="12" fill="#faf6ef">41</text>
  <!-- boats -->
  <g fill="#faf6ef" stroke="#2f5d62" stroke-width="1.5">
    <path d="M200 330h40l-6 9h-28Z" /><path d="M262 344h34l-5 8h-24Z" /><path d="M380 322h44l-7 10h-30Z" />
  </g>
  <!-- labels -->
  <g font-family="Inter, sans-serif" font-size="13" fill="#1f2a30">
    <text x="560" y="275" font-weight="600" letter-spacing="1.5" font-size="11" fill="#1f2a30" fill-opacity=".6">QUAY ROW</text>
    <text x="208" y="70" transform="rotate(-90 208 70)" font-size="11" letter-spacing="1.5" fill-opacity=".6" text-anchor="middle">CHAPEL ST</text>
    <text x="575" y="160" transform="rotate(-50 575 160)" font-size="11" letter-spacing="1.5" fill-opacity=".6" text-anchor="middle">HILL ROAD</text>
    <text x="120" y="249" text-anchor="middle" font-size="11" fill-opacity=".7">Harbour Square</text>
    <text x="538" y="336" text-anchor="middle" font-size="11" fill-opacity=".7">Quay car park</text>
    <text x="320" y="395" text-anchor="middle" font-family="Fraunces, serif" font-style="italic" font-size="18" fill="#2f5d62">Port Alder harbour</text>
  </g>
  <!-- café pin -->
  <g transform="translate(321 168)">
    <path d="M0 42c-4-9-16-18-16-28a16 16 0 0 1 32 0c0 10-12 19-16 28Z" fill="#b5532c" stroke="#faf6ef" stroke-width="2.5" />
    <circle cy="14" r="5.5" fill="#faf6ef" />
    <rect x="-52" y="-30" width="104" height="24" rx="12" fill="#1f2a30" />
    <text y="-13" text-anchor="middle" font-family="Fraunces, serif" font-size="14" fill="#faf6ef">Tern &amp; Tide</text>
  </g>
  <!-- compass -->
  <g transform="translate(600 30)" font-family="Inter, sans-serif" font-size="11" font-weight="600" fill="#1f2a30" fill-opacity=".6" text-anchor="middle">
    <path d="M0-12 5 6 0 2-5 6Z" />
    <text y="20">N</text>
  </g>
</svg>
