---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import OpenBadge from '../components/OpenBadge.astro';
import HarbourMap from '../components/HarbourMap.astro';
import HoursTable from '../components/HoursTable.astro';
import Tern from '../components/Tern.astro';
import EventRow from '../components/EventRow.astro';
import { formatDate, formatPrice, getEvents, getPosts, getSite } from '../lib/site';
import { cafeJsonLd } from '../lib/jsonld';

const site = await getSite();
const home = (await getEntry('home', 'home'))!.data;
const { upcoming } = await getEvents();
const posts = (await getPosts()).slice(0, 2);

// The welcome statement may hold photos between its words, written as
// {image-name} in src/data/home.yaml.
const statement = home.welcome.title.split(/\{([\w-]+)\}/).map((part, i) => ({ image: i % 2 === 1, text: part }));

// Prices for the signature dishes come from the menu, so they never differ.
const menuItems = (await getCollection('menu')).flatMap((section) => section.data.items);
const priceOf = (name: string) => menuItems.find((item) => item.name === name)?.price;

const two = (n: number) => String(n).padStart(2, '0');
---

<Base jsonLd={cafeJsonLd(site, Astro.site!)} overlayHeader flushFooter>
  <!-- Hero: the video behind the header, the name across the whole width -->
  <section class="hero relative isolate -mt-16 flex min-h-[100svh] flex-col justify-end overflow-hidden text-foam">
    <Img name={home.hero.image} sizes="100vw" priority class="absolute inset-0 -z-10 size-full object-cover" />
    <video src="/videos/hero.mp4" poster="/videos/hero-poster.jpg"
           autoplay muted loop playsinline aria-hidden="true"
           class="absolute inset-0 -z-10 size-full object-cover"></video>
    <script is:inline>
      // Runs as soon as the video above is parsed: anyone who prefers
      // reduced motion gets the poster only. Autoplay is switched off and
      // the download the browser has already started is stopped.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const video = document.currentScript.previousElementSibling;
        video.removeAttribute('autoplay');
        video.preload = 'none';
        video.load();
      }
    </script>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/90 via-ink/45 to-ink/40 sm:via-ink/25"></div>

    <div class="container-page pt-32">
      <div class="hero-rise grid gap-8 border-b border-foam/25 pb-8 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <OpenBadge />
          <p class="mt-5 max-w-lg text-lg leading-relaxed text-foam/90 sm:text-xl">{site.tagline} {home.hero.intro}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/menu" class="btn btn-light">See the menu</a>
          <a href="/visit" class="btn btn-outline text-foam">Plan your visit</a>
        </div>
      </div>
      <h1 class="wordmark hero-rise">
        Tern <span class="italic text-oat">&amp;</span> Tide
      </h1>
      <dl class="hero-rise grid grid-cols-2 gap-4 pb-6 text-xs tracking-[0.14em] text-foam/75 uppercase sm:grid-cols-4">
        <div><dt class="sr-only">Where</dt><dd>{site.address.street}, {site.address.town}</dd></div>
        <div><dt class="sr-only">Since</dt><dd>Est. 2019</dd></div>
        <div class="hidden sm:block"><dt class="sr-only">What</dt><dd>Café · Bakery · Kitchen</dd></div>
        <div class="hidden text-right sm:block"><dt class="sr-only">Supper club</dt><dd>Supper club monthly</dd></div>
      </dl>
    </div>
  </section>

  <!-- Welcome: one big sentence with photos between the words -->
  <section class="container-page py-20 sm:py-28">
    <p class="eyebrow reveal"><span class="num">01</span>Welcome</p>
    <h2 class="statement reveal mt-8">
      {statement.map((part) => part.image ? (
        <span class="statement-photo"><Img name={part.text} sizes="12rem" class="size-full object-cover" /></span>
      ) : part.text)}
    </h2>
    <div class="mt-16 grid gap-12 border-t border-oat pt-10 md:grid-cols-12 md:gap-8 sm:mt-24">
      <p class="reveal text-sm tracking-[0.14em] text-ink/70 uppercase md:col-span-3">Maren &amp; Teo,<br />since 2019</p>
      <div class="reveal md:col-span-5">
        <p class="text-lg leading-relaxed text-ink/80 sm:text-xl">{home.welcome.text}</p>
        <a href="/about" class="arrow-link mt-8">Our story</a>
      </div>
      <div class="reveal md:col-span-4">
        <h3 class="text-xs font-semibold tracking-[0.14em] text-ink/70 uppercase font-sans">Opening hours</h3>
        <div class="mt-3"><HoursTable /></div>
        <p class="mt-4 text-sm text-ink/70">Supper club: {site.supperClub}</p>
      </div>
    </div>
  </section>

  <!-- Signatures -->
  <section class="grain bg-sand py-20 sm:py-28">
    <div class="container-page">
      <div class="reveal grid gap-6 md:grid-cols-12 md:items-end">
        <div class="md:col-span-8">
          <p class="eyebrow"><span class="num">02</span>From the kitchen</p>
          <h2 class="section-title mt-6">What people <em>come back</em> for</h2>
        </div>
        <a href="/menu" class="arrow-link md:col-span-4 md:justify-self-end">The whole menu</a>
      </div>
      <ol class="mt-16 grid gap-14 md:grid-cols-3 md:gap-8 lg:gap-12">
        {home.signatures.map((dish, i) => (
          <li class:list={['dish reveal', i === 1 && 'md:mt-28', i === 2 && 'md:mt-12']}>
            <div class="aspect-[4/5] overflow-hidden rounded-[2px]">
              <Img name={dish.image} sizes="(min-width: 768px) 30vw, 100vw" class="dish-img size-full object-cover" />
            </div>
            <div class="mt-6 flex items-baseline justify-between gap-4 border-b border-ink/15 pb-3">
              <h3 class="text-2xl"><span class="mr-3 align-top font-sans text-xs font-semibold tracking-widest text-rust">{two(i + 1)}</span>{dish.name}</h3>
              {priceOf(dish.name) !== undefined && <p class="font-display text-lg italic tabular-nums">{formatPrice(priceOf(dish.name)!)}</p>}
            </div>
            <p class="mt-3 text-ink/75">{dish.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- A slow band of what's on the counter -->
  <div class="marquee bg-tide-dark py-5 text-foam sm:py-6" aria-hidden="true">
    {[0, 1].map(() => (
      <ul class="marquee-track">
        {home.marquee.map((word) => (
          <li class="flex items-center gap-10 pr-10">
            <span class="font-display text-3xl italic sm:text-4xl">{word}</span>
            <Tern class="h-5 w-8 text-oat sm:h-6 sm:w-9" />
          </li>
        ))}
      </ul>
    ))}
  </div>

  <!-- Quotes beside the harbour -->
  <section class="bg-tide-dark text-foam">
    <div class="grid md:grid-cols-2">
      <div class="relative min-h-[60svh] md:min-h-full">
        <Img name="harbour-dawn" sizes="(min-width: 768px) 50vw, 100vw" class="absolute inset-0 size-full object-cover" />
      </div>
      <div class="px-5 py-20 sm:px-12 sm:py-28 lg:px-20">
        <p class="eyebrow !text-oat reveal"><span class="num !text-foam/60">03</span>Said on the quay</p>
        <h2 class="sr-only">What guests say</h2>
        <ul class="mt-10 divide-y divide-foam/15">
          {home.quotes.map((q, i) => (
            <li class="reveal py-8 first:pt-0 last:pb-0">
              <blockquote>
                <p class:list={['font-display leading-[1.15] italic', i === 0 ? 'text-3xl sm:text-4xl' : 'text-xl sm:text-2xl text-foam/90']}>“{q.text}”</p>
                <footer class="mt-4 text-sm tracking-wide text-foam/70">— {q.author}</footer>
              </blockquote>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Events as a programme -->
  <section class="container-page py-20 sm:py-28">
    <div class="reveal grid gap-6 md:grid-cols-12 md:items-end">
      <div class="md:col-span-8">
        <p class="eyebrow"><span class="num">04</span>Coming up</p>
        <h2 class="section-title mt-6">Suppers, workshops <em>&amp;</em> lanterns</h2>
      </div>
      <a href="/events" class="arrow-link md:col-span-4 md:justify-self-end">All events</a>
    </div>
    {upcoming.length > 0 ? (
      <ul class="mt-14 border-t border-ink/15">
        {upcoming.slice(0, 3).map((event) => <li class="reveal"><EventRow event={event} /></li>)}
      </ul>
    ) : (
      <p class="mt-10 text-lg text-ink/75">Nothing planned right now. The next supper club will be here soon.</p>
    )}
  </section>

  <!-- Journal -->
  <section class="container-page pb-20 sm:pb-28">
    <div class="reveal grid gap-6 md:grid-cols-12 md:items-end">
      <div class="md:col-span-8">
        <p class="eyebrow"><span class="num">05</span>Journal</p>
        <h2 class="section-title mt-6">News from <em>the quay</em></h2>
      </div>
      <a href="/journal" class="arrow-link md:col-span-4 md:justify-self-end">All posts</a>
    </div>
    <div class="mt-14 grid gap-14 md:grid-cols-12 md:gap-8">
      {posts.map((post, i) => (
        <article class:list={['reveal group relative', i === 0 ? 'md:col-span-7' : 'md:col-span-4 md:col-start-9 md:mt-32']}>
          <div class:list={['overflow-hidden rounded-[2px] bg-sand', i === 0 ? 'aspect-[4/3]' : 'aspect-[4/5]']}>
            <Img name={post.data.image} sizes={i === 0 ? '(min-width: 768px) 58vw, 100vw' : '(min-width: 768px) 33vw, 100vw'} class="size-full object-cover transition-transform duration-700 group-hover:scale-105" />
          </div>
          <p class="mt-5 text-xs font-semibold tracking-[0.14em] text-ink/70 uppercase">
            <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time> · {post.data.author}
          </p>
          <h3 class="mt-2 text-2xl leading-snug sm:text-3xl">
            <a href={`/journal/${post.id}`} class="after:absolute after:inset-0 group-hover:text-tide">{post.data.title}</a>
          </h3>
          <p class="mt-3 max-w-lg text-ink/75">{post.data.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Find us -->
  <section class="grain grid bg-sand md:grid-cols-2">
    <div class="px-5 py-20 sm:px-12 sm:py-28 lg:px-20">
      <p class="eyebrow reveal"><span class="num">06</span>Find us</p>
      <h2 class="reveal mt-8 text-[clamp(2.25rem,3.8vw,3.5rem)] leading-[1.08]">
        {site.address.street},<br /><em class="text-tide">{site.address.town}</em>
      </h2>
      <dl class="reveal mt-12 grid gap-6 border-t border-ink/15 pt-8 sm:grid-cols-2">
        <div><dt class="text-xs font-semibold tracking-[0.14em] text-ink/70 uppercase">By bus</dt><dd class="mt-2">Two minutes from the 41 at Harbour Square.</dd></div>
        <div><dt class="text-xs font-semibold tracking-[0.14em] text-ink/70 uppercase">By car</dt><dd class="mt-2">Parking on the quay, east of the café.</dd></div>
      </dl>
      <div class="reveal mt-10 flex flex-wrap gap-3">
        <a href="/visit" class="btn btn-primary">How to get here</a>
        <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="btn btn-outline">{site.phone}</a>
      </div>
    </div>
    <HarbourMap class="h-full min-h-[22rem] w-full" />
  </section>
</Base>
