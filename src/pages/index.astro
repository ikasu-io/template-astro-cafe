---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import OpenBadge from '../components/OpenBadge.astro';
import EventCard from '../components/EventCard.astro';
import PostCard from '../components/PostCard.astro';
import HarbourMap from '../components/HarbourMap.astro';
import HoursTable from '../components/HoursTable.astro';
import { getEvents, getPosts, getSite } from '../lib/site';
import { cafeJsonLd } from '../lib/jsonld';

const site = await getSite();
const home = (await getEntry('home', 'home'))!.data;
const { upcoming } = await getEvents();
const posts = (await getPosts()).slice(0, 2);
---

<Base jsonLd={cafeJsonLd(site, Astro.site!)}>
  <!-- Hero -->
  <section class="relative isolate flex min-h-[86svh] items-end overflow-hidden text-foam">
    <Img name={home.hero.image} sizes="100vw" priority class="absolute inset-0 -z-10 size-full object-cover" />
    <video src="/videos/hero.mp4" poster="/videos/hero-poster.jpg"
           autoplay muted loop playsinline aria-hidden="true"
           class="absolute inset-0 -z-10 size-full object-cover"></video>
    <script is:inline>
      // Runs as soon as the video above is parsed: anyone who prefers
      // reduced motion gets the poster only. Autoplay is switched off and
      // the download the browser has already started is stopped.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const video = document.currentScript.previousElementSibling;
        video.removeAttribute('autoplay');
        video.preload = 'none';
        video.load();
      }
    </script>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/90 via-ink/50 to-ink/10"></div>
    <div class="container-page pt-32 pb-14 sm:pb-20">
      <OpenBadge />
      <h1 class="mt-5 max-w-3xl text-[clamp(3rem,9vw,7rem)] leading-[0.95] font-normal">
        Tern <span class="italic">&amp;</span> Tide
      </h1>
      <p class="mt-5 max-w-xl text-lg text-foam/90 sm:text-xl">{site.tagline} {home.hero.intro}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/menu" class="btn btn-light">See the menu</a>
        <a href="/visit" class="btn btn-outline text-foam">Plan your visit</a>
      </div>
    </div>
  </section>

  <!-- Welcome + hours -->
  <section class="container-page grid gap-12 py-20 sm:py-28 md:grid-cols-[1.3fr_1fr] md:gap-20">
    <div class="reveal">
      <p class="eyebrow">Welcome</p>
      <h2 class="mt-3 text-4xl leading-tight sm:text-5xl">{home.welcome.title}</h2>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink/80">{home.welcome.text}</p>
      <a href="/about" class="link mt-6 inline-block font-medium">Our story →</a>
    </div>
    <div class="reveal rounded-3xl bg-sand p-7 sm:p-9">
      <h2 class="text-2xl">Opening hours</h2>
      <div class="mt-4"><HoursTable /></div>
      <p class="mt-5 text-sm text-ink/70">Supper club: {site.supperClub}</p>
    </div>
  </section>

  <!-- Signatures -->
  <section class="bg-sand py-20 sm:py-28">
    <div class="container-page">
      <div class="reveal flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">From the kitchen</p>
          <h2 class="mt-3 text-4xl sm:text-5xl">What people come back for</h2>
        </div>
        <a href="/menu" class="link font-medium">The whole menu →</a>
      </div>
      <ul class="mt-12 grid gap-8 md:grid-cols-3">
        {home.signatures.map((dish) => (
          <li class="reveal">
            <div class="aspect-[4/5] overflow-hidden rounded-2xl">
              <Img name={dish.image} sizes="(min-width: 768px) 33vw, 100vw" class="size-full object-cover" />
            </div>
            <h3 class="mt-5 text-2xl">{dish.name}</h3>
            <p class="mt-1.5 text-ink/75">{dish.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Quotes over the harbour -->
  <section class="relative isolate overflow-hidden py-24 text-foam sm:py-32">
    <Img name="harbour-dawn" sizes="100vw" class="absolute inset-0 -z-10 size-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-tide-dark/75"></div>
    <div class="container-page">
      <h2 class="sr-only">What guests say</h2>
      <ul class="grid gap-10 md:grid-cols-3">
        {home.quotes.map((q) => (
          <li class="reveal">
            <blockquote>
              <p class="font-display text-2xl leading-snug italic">“{q.text}”</p>
              <footer class="mt-4 text-sm text-foam/75">— {q.author}</footer>
            </blockquote>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Events -->
  <section class="container-page py-20 sm:py-28">
    <div class="reveal flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Coming up</p>
        <h2 class="mt-3 text-4xl sm:text-5xl">Suppers, workshops and lanterns</h2>
      </div>
      <a href="/events" class="link font-medium">All events →</a>
    </div>
    {upcoming.length > 0 ? (
      <div class="mt-12 grid gap-10 lg:grid-cols-2">
        {upcoming.slice(0, 2).map((event) => <div class="reveal"><EventCard event={event} /></div>)}
      </div>
    ) : (
      <p class="mt-8 text-lg text-ink/75">Nothing planned right now. The next supper club will be here soon.</p>
    )}
  </section>

  <!-- Journal -->
  <section class="border-t border-oat/60">
    <div class="container-page py-20 sm:py-28">
      <div class="reveal flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Journal</p>
          <h2 class="mt-3 text-4xl sm:text-5xl">News from the quay</h2>
        </div>
        <a href="/journal" class="link font-medium">All posts →</a>
      </div>
      <div class="mt-12 grid gap-10 md:grid-cols-2">
        {posts.map((post) => <div class="reveal"><PostCard post={post} sizes="(min-width: 768px) 50vw, 100vw" /></div>)}
      </div>
    </div>
  </section>

  <!-- Find us -->
  <section class="container-page">
    <div class="reveal grid overflow-hidden rounded-3xl bg-sand md:grid-cols-[1fr_1.2fr]">
      <div class="p-8 sm:p-12">
        <p class="eyebrow">Find us</p>
        <h2 class="mt-3 text-4xl">On the harbour wall</h2>
        <p class="mt-5 text-lg">{site.address.street}, {site.address.town}</p>
        <p class="mt-2 text-ink/75">Two minutes from the 41 bus at Harbour Square. Parking on the quay.</p>
        <a href="/visit" class="btn btn-primary mt-8">How to get here</a>
      </div>
      <HarbourMap class="h-full w-full" />
    </div>
  </section>
</Base>
