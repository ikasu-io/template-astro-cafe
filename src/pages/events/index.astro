---
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import { getEvents, getSite } from '../../lib/site';

const site = await getSite();
const { upcoming, past } = await getEvents();
---

<Base title="Events" description="Supper clubs, baking mornings and evenings on the quay at Tern & Tide." image="supper-club">
  <header class="container-page pt-16 pb-12 sm:pt-24">
    <p class="eyebrow">Events</p>
    <h1 class="mt-3 text-5xl sm:text-6xl">Suppers, workshops and lanterns</h1>
    <p class="mt-5 max-w-2xl text-lg text-ink/80">
      Supper club: {site.supperClub} Book anything here by phone on <a class="link" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a> or by email at <a class="link" href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </header>

  <section class="container-page" aria-labelledby="upcoming">
    <h2 id="upcoming" class="sr-only">Upcoming events</h2>
    {upcoming.length > 0 ? (
      <div class="grid gap-12">{upcoming.map((event) => <div class="reveal"><EventCard event={event} /></div>)}</div>
    ) : (
      <p class="text-lg text-ink/75">Nothing planned right now. The next supper club will be here soon.</p>
    )}
  </section>

  {past.length > 0 && (
    <section class="container-page mt-24 border-t border-oat/70 pt-14" aria-labelledby="past">
      <h2 id="past" class="text-3xl">Past events</h2>
      <div class="mt-10 grid gap-12">{past.map((event) => <EventCard event={event} past />)}</div>
    </section>
  )}
</Base>
