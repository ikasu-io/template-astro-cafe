---
import Base from '../../layouts/Base.astro';
import EventRow from '../../components/EventRow.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getEvents, getSite } from '../../lib/site';

const site = await getSite();
const { upcoming, past } = await getEvents();
---

<Base title="Events" description="Supper clubs, baking mornings and evenings on the quay at Tern & Tide." image="supper-club">
  <PageHeader eyebrow="Events" title="Suppers, workshops and lanterns">
    Supper club: {site.supperClub} Book anything by phone on <a class="link" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a> or by email at <a class="link" href={`mailto:${site.email}`}>{site.email}</a>.
  </PageHeader>

  <section class="container-page pt-6" aria-labelledby="upcoming">
    <h2 id="upcoming" class="sr-only">Upcoming events</h2>
    {upcoming.length > 0 ? (
      <ul>{upcoming.map((event) => <li class="reveal"><EventRow event={event} /></li>)}</ul>
    ) : (
      <p class="py-10 text-lg text-ink/75">Nothing planned right now. The next supper club will be here soon.</p>
    )}
  </section>

  {past.length > 0 && (
    <section class="container-page mt-24 sm:mt-32" aria-labelledby="past">
      <p class="eyebrow"><span class="num">{past.length}</span>Archive</p>
      <h2 id="past" class="section-title mt-5">Past events</h2>
      <ul class="mt-10 border-t border-ink/15">{past.map((event) => <li><EventRow event={event} past /></li>)}</ul>
    </section>
  )}
</Base>
