---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import { formatDate, formatTime, getSite } from '../../lib/site';
import { eventJsonLd } from '../../lib/jsonld';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}

interface Props { event: CollectionEntry<'events'> }
const { event } = Astro.props;
const { Content } = await render(event);
const site = await getSite();
const { title, date, time, endTime, price, image, summary } = event.data;
const isPast = date < new Date(new Date().toISOString().slice(0, 10));
---

<Base title={title} description={summary} image={image} jsonLd={eventJsonLd(event, site, Astro.site!)}>
  <article>
    <header class="container-page pt-12 sm:pt-16">
      <a href="/events" class="link text-sm font-medium">← All events</a>
      <p class="eyebrow mt-8">{isPast ? 'Past event' : 'Event'}</p>
      <h1 class="mt-3 max-w-3xl text-5xl leading-[1.05] sm:text-6xl">{title}</h1>
      <p class="mt-5 max-w-2xl text-lg text-ink/80">{summary}</p>
    </header>

    <div class="container-page mt-10">
      <div class="aspect-[3/2] overflow-hidden rounded-3xl sm:aspect-[21/9]">
        <Img name={image} sizes="(min-width: 72rem) 72rem, 100vw" priority class="size-full object-cover" />
      </div>
    </div>

    <div class="container-page grid gap-12 py-14 lg:grid-cols-[1fr_20rem] lg:gap-20">
      <div class="prose"><Content /></div>
      <aside class="self-start rounded-3xl bg-sand p-7 lg:sticky lg:top-28">
        <dl class="space-y-4">
          <div><dt class="eyebrow">Date</dt><dd class="mt-1 text-lg">{formatDate(date, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</dd></div>
          <div><dt class="eyebrow">Time</dt><dd class="mt-1 text-lg">{formatTime(time)}{endTime && ` – ${formatTime(endTime)}`}</dd></div>
          <div><dt class="eyebrow">Price</dt><dd class="mt-1 text-lg">{price}</dd></div>
          <div><dt class="eyebrow">Where</dt><dd class="mt-1 text-lg">{site.name}, {site.address.street}</dd></div>
        </dl>
        {!isPast && (
          <div class="mt-7 grid gap-2">
            <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="btn btn-primary justify-center">Call {site.phone}</a>
            <a href={`mailto:${site.email}?subject=${encodeURIComponent(title)}`} class="btn btn-outline justify-center text-tide">Email to book</a>
          </div>
        )}
      </aside>
    </div>
  </article>
</Base>
