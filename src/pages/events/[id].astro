---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import { formatDate, formatTime, getSite } from '../../lib/site';
import { eventJsonLd } from '../../lib/jsonld';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}

interface Props { event: CollectionEntry<'events'> }
const { event } = Astro.props;
const { Content } = await render(event);
const site = await getSite();
const { title, date, time, endTime, price, image, summary } = event.data;
const isPast = date < new Date(new Date().toISOString().slice(0, 10));
---

<Base title={title} description={summary} image={image} jsonLd={eventJsonLd(event, site, Astro.site!)}>
  <article>
    <header class="container-page pt-14 sm:pt-20">
      <a href="/events" class="back-link">All events</a>
      <div class="mt-10 grid gap-8 border-b border-ink/15 pb-12 md:grid-cols-12 md:items-end md:gap-8">
        <div class="md:col-span-8">
          <p class="eyebrow">{isPast ? 'Past event' : formatDate(date, { weekday: 'long', day: 'numeric', month: 'long' })}</p>
          <h1 class="page-title mt-6">{title}</h1>
        </div>
        <p class="text-lg text-ink/80 md:col-span-4">{summary}</p>
      </div>
    </header>

    <div class="container-page mt-10 sm:mt-14">
      <div class="aspect-[3/2] overflow-hidden rounded-[2px] sm:aspect-[21/9]">
        <Img name={image} sizes="(min-width: 90rem) 84rem, 100vw" priority class="size-full object-cover" />
      </div>
    </div>

    <div class="container-page grid gap-12 py-16 sm:py-24 lg:grid-cols-12 lg:gap-8">
      <div class="prose lg:col-span-7"><Content /></div>
      <aside class="grain self-start bg-sand p-8 lg:sticky lg:top-28 lg:col-span-4 lg:col-start-9">
        <dl class="divide-y divide-ink/15">
          <div class="py-4 first:pt-0"><dt class="eyebrow">Date</dt><dd class="mt-1 text-lg">{formatDate(date, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</dd></div>
          <div class="py-4 first:pt-0"><dt class="eyebrow">Time</dt><dd class="mt-1 text-lg">{formatTime(time)}{endTime && ` – ${formatTime(endTime)}`}</dd></div>
          <div class="py-4 first:pt-0"><dt class="eyebrow">Price</dt><dd class="mt-1 text-lg">{price}</dd></div>
          <div class="py-4 first:pt-0"><dt class="eyebrow">Where</dt><dd class="mt-1 text-lg">{site.name}, {site.address.street}</dd></div>
        </dl>
        {!isPast && (
          <div class="mt-6 grid gap-2">
            <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="btn btn-primary justify-center">Call {site.phone}</a>
            <a href={`mailto:${site.email}?subject=${encodeURIComponent(title)}`} class="btn btn-outline justify-center text-tide">Email to book</a>
          </div>
        )}
      </aside>
    </div>
  </article>
</Base>
