---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import HarbourMap from '../components/HarbourMap.astro';
import HoursTable from '../components/HoursTable.astro';
import OpenBadge from '../components/OpenBadge.astro';
import { getSite } from '../lib/site';
import { cafeJsonLd } from '../lib/jsonld';

const site = await getSite();
const page = (await getEntry('pages', 'visit'))!;
const { Content } = await render(page);
const { title, description, image, faq = [] } = page.data;
const tel = site.phone.replace(/\s/g, '');
---

<Base title={title} description={description} image={image} jsonLd={cafeJsonLd(site, Astro.site!)} overlayHeader>
  <section class="relative isolate -mt-16 flex min-h-[78svh] flex-col justify-end overflow-hidden text-foam">
    <Img name={image} sizes="100vw" priority class="absolute inset-0 -z-10 size-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/85 via-ink/35 to-ink/45"></div>
    <div class="container-page pt-32 pb-12 sm:pb-16">
      <div class="hero-rise grid gap-8 md:grid-cols-12 md:items-end">
        <div class="md:col-span-8">
          <OpenBadge />
          <h1 class="page-title mt-6 !text-[clamp(2.75rem,5.5vw,5rem)]">Come and see us</h1>
        </div>
        <p class="text-lg text-foam/90 md:col-span-4 md:text-right">{site.address.street}<br />{site.address.town}</p>
      </div>
    </div>
  </section>

  <section class="container-page grid gap-12 py-20 sm:py-28 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-5">
      <p class="eyebrow"><span class="num">01</span>Opening hours</p>
      <div class="mt-8"><HoursTable /></div>
      <p class="mt-5 text-ink/75">Supper club: {site.supperClub}</p>
    </div>
    <div id="booking" class="grain self-start bg-sand p-8 sm:p-12 md:col-span-6 md:col-start-7">
      <p class="eyebrow"><span class="num">02</span>Booking</p>
      <h2 class="section-title mt-6">Walk in, or <em>call ahead</em></h2>
      <p class="mt-5 text-ink/80">
        Breakfast and lunch are walk-in. We take bookings for groups of six or more and for the supper club; call or
        email us and we’ll get back to you the same day.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`tel:${tel}`} class="btn btn-primary">Call {site.phone}</a>
        <a href={`mailto:${site.email}?subject=Booking`} class="btn btn-outline text-tide">Email us</a>
      </div>
    </div>
  </section>

  <section class="container-page grid gap-12 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-5">
      <p class="eyebrow"><span class="num">03</span>Directions</p>
      <div class="prose mt-8"><Content /></div>
    </div>
    <div class="self-start overflow-hidden rounded-[2px] md:sticky md:top-28 md:col-span-6 md:col-start-7">
      <HarbourMap class="w-full" />
    </div>
  </section>

  <section class="container-page grid gap-12 py-20 sm:py-28 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-5">
      <p class="eyebrow"><span class="num">04</span>Good to know</p>
      <h2 class="section-title mt-6">Questions <em>people ask</em></h2>
    </div>
    <div class="divide-y divide-ink/15 border-y border-ink/15 md:col-span-6 md:col-start-7">
      {faq.map((item) => (
        <details class="group py-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-xl [&::-webkit-details-marker]:hidden">
            {item.q}
            <span class="text-2xl text-rust transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 max-w-2xl text-ink/80">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-page">
    <div class="aspect-[3/2] overflow-hidden rounded-[2px] sm:aspect-[21/9]">
      <Img name="storefront" sizes="(min-width: 90rem) 84rem, 100vw" class="size-full object-cover" />
    </div>
  </section>
</Base>
