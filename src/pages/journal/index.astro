---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { formatDate, getPosts } from '../../lib/site';

const [latest, ...rest] = await getPosts();
---

<Base title="Journal" description="News from Tern & Tide: new menus, our suppliers and life on the quay." image="day-boat-catch">
  <PageHeader eyebrow="Journal" title="News from the quay">
    New menus, the people we buy from, and whatever else is going on at number 14.
  </PageHeader>

  <div class="container-page pt-10 sm:pt-14">
    <h2 class="sr-only">All posts</h2>
    {latest && (
      <article class="group relative grid gap-8 md:grid-cols-12 md:items-end md:gap-8">
        <div class="aspect-[4/3] overflow-hidden rounded-[2px] bg-sand md:col-span-8">
          <Img name={latest.data.image} sizes="(min-width: 768px) 60vw, 100vw" priority class="size-full object-cover transition-transform duration-700 group-hover:scale-105" />
        </div>
        <div class="md:col-span-4">
          <p class="eyebrow"><span class="num">New</span>{formatDate(latest.data.date)}</p>
          <h3 class="page-title mt-5 !text-[clamp(2rem,3vw,2.75rem)]">
            <a href={`/journal/${latest.id}`} class="after:absolute after:inset-0 group-hover:text-tide">{latest.data.title}</a>
          </h3>
          <p class="mt-4 text-lg text-ink/75">{latest.data.summary}</p>
          <p class="mt-6 text-xs font-semibold tracking-[0.14em] text-ink/70 uppercase">By {latest.data.author}</p>
        </div>
      </article>
    )}
    <div class="mt-24 grid gap-x-8 gap-y-16 border-t border-ink/15 pt-14 md:grid-cols-2 lg:gap-x-16">
      {rest.map((post, i) => (
        <div class:list={['reveal', i % 2 === 1 && 'md:mt-24']}>
          <PostCard post={post} aspect="aspect-[4/3]" sizes="(min-width: 768px) 45vw, 100vw" large />
        </div>
      ))}
    </div>
  </div>
</Base>
